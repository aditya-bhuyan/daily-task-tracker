# Dependencies
node_modules/

# Build output (electron-vite)
out/
dist/

# SQLite database files (user data - never commit)
*.db
*.db-shm
*.db-wal

# Environment and secrets
.env
.env.*
!.env.example

# Editor and IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build cache
*.tsbuildinfo

# Vite cache
.vite/

# electron-builder artifacts
dist-electron/
release/

# Test coverage
coverage/
.nyc_output/
# Expo / React Native (generated at runtime — never commit)
.expo/
android/
ios/
